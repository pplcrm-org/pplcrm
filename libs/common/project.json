{
  "name": "common",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/common/src",
  "projectType": "library",
  "targets": {
    "generate-context": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx repomix --output apps/libs/STRUCTURE.md --style markdown --include \"libs/common/src/**/*,libs/uxcommon/src/**/*\""
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["libs/common/**/*.ts"]
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "outputs": ["{workspaceRoot}/coverage/libs/common"],
      "options": {
        "cwd": "libs/common",
        "command": "vitest run"
      }
    }
  },
  "tags": []
}
