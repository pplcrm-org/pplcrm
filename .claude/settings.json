{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Bash(cat .env*)",
      "Bash(cat **/.env*)",

      "Bash(git commit --no-verify*)",
      "Bash(git push --no-verify*)",
      "Bash(git push --force*)",
      "Bash(git push * --force*)",
      "Bash(git push --force-with-lease*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -fd*)",

      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(curl * | sh*)",
      "Bash(curl * | bash*)",
      "Bash(wget * | sh*)",
      "Bash(wget * | bash*)"
    ],

    "ask": [
      "Bash(git push*)",
      "Bash(gh pr merge*)",
      "Bash(gh release*)",
      "Bash(npm publish*)",
      "Bash(az *)",
      "Bash(npx wrangler deploy*)",
      "Bash(npx wrangler * delete*)",
      "Bash(nx migrate*)",
      "Bash(npx nx migrate*)"
    ],

    "allow": [
      "Bash(nx *)",
      "Bash(npx nx *)",
      "Bash(npm run *)",
      "Bash(npm ci*)",
      "Bash(npm install*)",
      "Bash(npm ls*)",
      "Bash(npm audit*)",
      "Bash(npx tsc*)",
      "Bash(npx eslint*)",
      "Bash(npx prettier*)",
      "Bash(npx vitest*)",
      "Bash(npx playwright*)",
      "Bash(npx wrangler dev*)",
      "Bash(npx wrangler tail*)",
      "Bash(tsc --noEmit*)",
      "Bash(eslint*)",
      "Bash(prettier*)",
      "Bash(node *)",

      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git blame*)",
      "Bash(git branch*)",
      "Bash(git stash*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git checkout*)",
      "Bash(git switch*)",
      "Bash(git restore*)",
      "Bash(git merge*)",
      "Bash(git rebase*)",
      "Bash(git fetch*)",
      "Bash(git pull*)",
      "Bash(git remote*)",
      "Bash(git rev-parse*)",
      "Bash(git ls-files*)",
      "Bash(git worktree*)",

      "Bash(gh pr view*)",
      "Bash(gh pr list*)",
      "Bash(gh pr diff*)",
      "Bash(gh pr checks*)",
      "Bash(gh pr create*)",
      "Bash(gh issue view*)",
      "Bash(gh issue list*)",
      "Bash(gh run view*)",
      "Bash(gh run list*)",
      "Bash(gh api *)",

      "Bash(psql*)",
      "Bash(pg_dump*)",
      "Bash(docker compose ps*)",
      "Bash(docker compose logs*)",
      "Bash(docker compose up*)",
      "Bash(docker compose down*)",
      "Bash(curl http://localhost*)",
      "Bash(curl http://127.0.0.1*)",

      "mcp__nx-mcp__*",

      "WebSearch",
      "WebFetch(domain:nx.dev)",
      "WebFetch(domain:angular.dev)",
      "WebFetch(domain:kysely.dev)",
      "WebFetch(domain:trpc.io)",
      "WebFetch(domain:daisyui.com)",
      "WebFetch(domain:tailwindcss.com)",
      "WebFetch(domain:fastify.dev)",
      "WebFetch(domain:zod.dev)",
      "WebFetch(domain:vitest.dev)",
      "WebFetch(domain:developers.cloudflare.com)",
      "WebFetch(domain:learn.microsoft.com)",
      "WebFetch(domain:docs.stripe.com)",
      "WebFetch(domain:docs.sendgrid.com)",
      "WebFetch(domain:postmarkapp.com)",
      "WebFetch(domain:developers.google.com)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:code.claude.com)"
    ]
  },

  "enabledPlugins": {
    "nx@nx-claude-plugins": true
  },

  "extraKnownMarketplaces": {
    "nx-claude-plugins": {
      "source": {
        "source": "github",
        "repo": "nrwl/nx-ai-agents-config"
      }
    }
  },

  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": true,
    "network": {
      "allowUnixSockets": ["/tmp/.s.PGSQL.5432", "/var/run/postgresql/.s.PGSQL.5432"],
      "allowLocalBinding": true,
      "allowedDomains": [
        "localhost",
        "127.0.0.1",
        "*.postgres.database.azure.com",
        "registry.npmjs.org",
        "*.npmjs.org",
        "registry.yarnpkg.com",
        "github.com",
        "api.github.com",
        "codeload.github.com",
        "objects.githubusercontent.com",
        "raw.githubusercontent.com",
        "*.githubusercontent.com",
        "nodejs.org",
        "cloud.nx.app",
        "api.anthropic.com",
        "code.claude.com",
        "docs.claude.com",
        "playwright.azureedge.net",
        "cdn.playwright.dev",
        "www.google-analytics.com"
      ]
    },

    "filesystem": {
      "// allowRead": "The Read(./.env.*) deny rules above also catch the committed *.example templates, which hold no secrets. lint-staged stats the whole tracked tree to take its backup stash, so the pre-commit hook dies on lstat(.env.development.example). Re-allow the templates only; the real .env.development/.production/.test are untracked, never stashed, and stay denied.",
      "allowRead": ["./.env.example", "./.env.*.example", "./**/.env.example", "./**/.env.*.example"]
    },

    "// excludedCommands": "Measured 2026-07-30, sandboxed, --skip-nx-cache: Angular builds are 3 green in 14 runs (frontend 0/3, companion 0/3, and 0/3 even with NG_BUILD_MAX_WORKERS=1), vs 8/8 green with CI=1. Cause: lmdb's open() dies silently on SIGABRT/134 under Seatbelt (POSIX named semaphores — an IPC denial no allowWrite fixes), and @angular/build opens that cache lazily OUTSIDE its own try/catch, so stderr is empty and it looks like a code error. CI=1 disables Angular's persistent cache and is the sandbox-preserving alternative when you want one. `nx build backend` is fine sandboxed (2/2, no LMDB) and needs no exclusion. `nx test backend` fails deterministically instead: .env.test is read-denied, so the globalSetup guardrail sees an empty DB_NAME — unsandboxed it is 1340/1340 green. Do NOT allow-read .env.test (it holds JWT_SECRET/SHARED_SECRET), and do NOT widen these globs to bare run-many*/affected*, which would un-sandbox lint and every other project's tests. Full evidence: .claude/skills/pplcrm-quality-gate/SKILL.md.",
    "excludedCommands": [
      "npx nx build*",
      "nx build*",
      "npx nx run *:build*",
      "npx nx run-many -t build*",
      "npx nx run-many --target=build*",
      "npx nx affected -t build*",
      "npx nx affected --target=build*",
      "npx nx test backend*",
      "nx test backend*",
      "npx nx run backend:test*"
    ]
  }
}
