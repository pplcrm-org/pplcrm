{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Bash(cat .env*)",
      "Bash(cat **/.env*)",

      "Bash(git commit --no-verify*)",
      "Bash(git push --no-verify*)",
      "Bash(git push --force*)",
      "Bash(git push * --force*)",
      "Bash(git push --force-with-lease*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -fd*)",
      "Bash(git filter-branch*)",
      "Bash(git push --delete*)",
      "Bash(git push * --delete*)",
      "Bash(git stash*)",

      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(curl * | sh*)",
      "Bash(curl * | bash*)",
      "Bash(wget * | sh*)",
      "Bash(wget * | bash*)"
    ],

    "// stash": "git stash is denied, not merely asked: other Claude sessions edit this same worktree at the same time, and a stash/pop once collided and had to be merged by hand. Use a commit or a worktree instead.",

    "// ask": "Three categories prompt: commands that create or move git commits, commands that publish anything off this machine, and commands that destroy data that is not trivially recreatable. Everything not listed here and not in the allow list below is judged by auto mode, which approves ordinary work without prompting.",
    "ask": [
      "Bash(git commit*)",
      "Bash(git push*)",
      "Bash(git merge*)",
      "Bash(git rebase*)",
      "Bash(git cherry-pick*)",
      "Bash(git revert*)",
      "Bash(git reset*)",
      "Bash(git checkout*)",
      "Bash(git restore*)",
      "Bash(git clean*)",
      "Bash(git branch -d*)",
      "Bash(git branch -D*)",
      "Bash(git tag -d*)",
      "Bash(git tag -f*)",
      "Bash(git worktree remove*)",
      "Bash(git worktree prune*)",
      "Bash(git remote add*)",
      "Bash(git remote remove*)",
      "Bash(git remote set-url*)",

      "Bash(gh pr create*)",
      "Bash(gh pr merge*)",
      "Bash(gh pr close*)",
      "Bash(gh pr edit*)",
      "Bash(gh issue close*)",
      "Bash(gh release*)",
      "Bash(gh repo delete*)",
      "Bash(gh api -X POST*)",
      "Bash(gh api -X PATCH*)",
      "Bash(gh api -X PUT*)",
      "Bash(gh api -X DELETE*)",
      "Bash(gh api --method POST*)",
      "Bash(gh api --method PATCH*)",
      "Bash(gh api --method PUT*)",
      "Bash(gh api --method DELETE*)",

      "Bash(npm publish*)",
      "Bash(az *)",
      "Bash(npx wrangler deploy*)",
      "Bash(npx wrangler * delete*)",
      "Bash(nx migrate*)",
      "Bash(npx nx migrate*)",

      "Bash(rm -r*)",
      "Bash(rm -f*)",
      "Bash(rmdir *)",
      "Bash(sed -i*)",
      "Bash(dropdb*)",
      "Bash(docker compose down -v*)",
      "Bash(docker volume rm*)",
      "Bash(docker system prune*)"
    ],

    "allow": [
      "Bash(tools/quiet.sh*)",
      "Bash(nx *)",
      "Bash(npx nx *)",
      "Bash(npm run *)",
      "Bash(npm ci*)",
      "Bash(npm install*)",
      "Bash(npm ls*)",
      "Bash(npm audit*)",
      "Bash(npx tsc*)",
      "Bash(npx eslint*)",
      "Bash(npx prettier*)",
      "Bash(npx vitest*)",
      "Bash(npx playwright*)",
      "Bash(npx wrangler dev*)",
      "Bash(npx wrangler tail*)",
      "Bash(tsc --noEmit*)",
      "Bash(eslint*)",
      "Bash(prettier*)",
      "Bash(node *)",

      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git blame*)",
      "Bash(git branch*)",
      "Bash(git add*)",
      "Bash(git switch*)",
      "Bash(git fetch*)",
      "Bash(git pull*)",
      "Bash(git remote -v*)",
      "Bash(git remote show*)",
      "Bash(git rev-parse*)",
      "Bash(git ls-files*)",
      "Bash(git worktree*)",

      "Bash(gh pr view*)",
      "Bash(gh pr list*)",
      "Bash(gh pr diff*)",
      "Bash(gh pr checks*)",
      "Bash(gh issue view*)",
      "Bash(gh issue list*)",
      "Bash(gh run view*)",
      "Bash(gh run list*)",

      "Bash(psql*)",
      "Bash(pg_dump*)",
      "Bash(docker compose ps*)",
      "Bash(docker compose logs*)",
      "Bash(docker compose up*)",
      "Bash(docker compose down*)",
      "Bash(curl http://localhost*)",
      "Bash(curl http://127.0.0.1*)",

      "mcp__nx-mcp__*",

      "WebSearch",
      "WebFetch(domain:nx.dev)",
      "WebFetch(domain:angular.dev)",
      "WebFetch(domain:kysely.dev)",
      "WebFetch(domain:trpc.io)",
      "WebFetch(domain:daisyui.com)",
      "WebFetch(domain:tailwindcss.com)",
      "WebFetch(domain:fastify.dev)",
      "WebFetch(domain:zod.dev)",
      "WebFetch(domain:vitest.dev)",
      "WebFetch(domain:developers.cloudflare.com)",
      "WebFetch(domain:learn.microsoft.com)",
      "WebFetch(domain:docs.stripe.com)",
      "WebFetch(domain:docs.sendgrid.com)",
      "WebFetch(domain:postmarkapp.com)",
      "WebFetch(domain:developers.google.com)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:code.claude.com)"
    ]
  },

  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/tools/claude-hooks/protect-generated.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/tools/claude-hooks/format-file.mjs\"",
            "timeout": 30,
            "statusMessage": "Formatting"
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/tools/claude-hooks/sync-reminders.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  },

  "enabledPlugins": {
    "nx@nx-claude-plugins": true
  },

  "extraKnownMarketplaces": {
    "nx-claude-plugins": {
      "source": {
        "source": "github",
        "repo": "nrwl/nx-ai-agents-config"
      }
    }
  },

  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": true,
    "network": {
      "allowUnixSockets": ["/tmp/.s.PGSQL.5432", "/var/run/postgresql/.s.PGSQL.5432"],
      "allowLocalBinding": true,
      "allowedDomains": [
        "localhost",
        "127.0.0.1",
        "*.postgres.database.azure.com",
        "registry.npmjs.org",
        "*.npmjs.org",
        "registry.yarnpkg.com",
        "github.com",
        "api.github.com",
        "codeload.github.com",
        "objects.githubusercontent.com",
        "raw.githubusercontent.com",
        "*.githubusercontent.com",
        "nodejs.org",
        "cloud.nx.app",
        "api.anthropic.com",
        "code.claude.com",
        "docs.claude.com",
        "playwright.azureedge.net",
        "cdn.playwright.dev",
        "www.google-analytics.com"
      ]
    },

    "filesystem": {
      "// allowRead": "The Read(./.env.*) deny rules above also catch the committed *.example templates, which hold no secrets. lint-staged stats the whole tracked tree to take its backup stash, so the pre-commit hook dies on lstat(.env.development.example). Re-allow the templates only; the real .env.development/.production/.test are untracked, never stashed, and stay denied.",
      "allowRead": ["./.env.example", "./.env.*.example", "./**/.env.example", "./**/.env.*.example"]
    },

    "// excludedCommands": "Measured 2026-07-30, sandboxed, --skip-nx-cache: Angular builds are 3 green in 14 runs (frontend 0/3, companion 0/3, and 0/3 even with NG_BUILD_MAX_WORKERS=1), vs 8/8 green with CI=1. Cause: lmdb's open() dies silently on SIGABRT/134 under Seatbelt (POSIX named semaphores — an IPC denial no allowWrite fixes), and @angular/build opens that cache lazily OUTSIDE its own try/catch, so stderr is empty and it looks like a code error. CI=1 disables Angular's persistent cache and is the sandbox-preserving alternative when you want one. `nx build backend` is fine sandboxed (2/2, no LMDB) and needs no exclusion. `nx test backend` fails deterministically instead: .env.test is read-denied, so the globalSetup guardrail sees an empty DB_NAME — unsandboxed it is 1340/1340 green. Do NOT allow-read .env.test (it holds JWT_SECRET/SHARED_SECRET), and do NOT widen these globs to bare run-many*/affected*, which would un-sandbox lint and every other project's tests. Full evidence: .claude/skills/pplcrm-quality-gate/SKILL.md.",
    "// excludedCommands via tools/quiet.sh": "tools/quiet.sh runs a verification command and prints one result line instead of a wall of output (CLAUDE.md §0a). These prefixes must be kept in step with the bare ones below: excludedCommands prefix-matches the command STRING, so wrapping a build in the helper changes what it matches, and without these entries the Angular builds and the backend tests silently drop back into the sandbox and hit the failures documented above.",
    "excludedCommands": [
      "tools/quiet.sh npx nx build*",
      "tools/quiet.sh nx build*",
      "tools/quiet.sh npx nx run *:build*",
      "tools/quiet.sh npx nx run-many -t build*",
      "tools/quiet.sh npx nx run-many --target=build*",
      "tools/quiet.sh npx nx affected -t build*",
      "tools/quiet.sh npx nx affected --target=build*",
      "tools/quiet.sh npx nx test backend*",
      "tools/quiet.sh nx test backend*",
      "tools/quiet.sh npx nx run backend:test*",

      "npx nx build*",
      "nx build*",
      "npx nx run *:build*",
      "npx nx run-many -t build*",
      "npx nx run-many --target=build*",
      "npx nx affected -t build*",
      "npx nx affected --target=build*",
      "npx nx test backend*",
      "nx test backend*",
      "npx nx run backend:test*"
    ]
  }
}
