{
  "$schema": "https://repomix.com/schemas/latest/schema.json",
  "input": {
    "maxFileSize": 52428800
  },
  "output": {
    "filePath": "ai.md",
    "style": "markdown",
    "parsableStyle": false,
    "headerText": "GENERATED FILE — do not edit by hand. Regenerate with `npm run context:all`.\n\nThis is a directory map only: it lists which files exist and where, and deliberately\ncontains NO file contents. To read code, open the real source with Read/Grep — it is\nalways current, where this snapshot is only correct as of its last regeneration.\n\n(Rationale: the full-source variant of this file was ~75k lines, too large for any agent\nto load, and it rewrote itself on nearly every commit. See repomix.config.json.)",
    "fileSummary": false,
    "directoryStructure": true,
    "files": false,
    "removeComments": false,
    "removeEmptyLines": false,
    "compress": false,
    "topFilesLength": 5,
    "showLineNumbers": false,
    "truncateBase64": false,
    "copyToClipboard": false,
    "includeFullDirectoryStructure": false,
    "tokenCountTree": false,
    "git": {
      "sortByChanges": false,
      "sortByChangesMaxCommits": 100,
      "includeDiffs": false,
      "includeLogs": false,
      "includeLogsCount": 50
    }
  },
  "ignore": {
    "useGitignore": true,
    "useDotIgnore": true,
    "useDefaultPatterns": true,
    "customPatterns": [
      "**/*.test.ts",
      "**/*.spec.ts",
      "**/dist/**",
      "**/build/**",
      "**/node_modules/**",
      "**/.git/**",
      "**/package-lock.json",
      "**/yarn.lock",
      "**/*.picture",
      "**/*.png",
      "**/*.jpg",
      "**/*.jpeg",
      "**/*.svg",
      "**/*.ico"
    ]
  },
  "security": {
    "enableSecurityCheck": true
  },
  "tokenCount": {
    "encoding": "o200k_base"
  }
}
